@model WebBanHoa.Models.GoodsReceiptNoteDTO
@{
    ViewBag.Title = "Tạo phiếu nhập kho";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}

<style>
    /* Tùy chỉnh CSS cho bảng nhập liệu */
    .table-input th {
        background-color: #f8f9fa;
        text-align: center;
        vertical-align: middle;
    }

    .table-input td {
        vertical-align: middle;
        padding: 5px;
    }

    .input-number {
        text-align: right;
    }
    /* Ẩn mũi tên tăng giảm của input number cho gọn */
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
</style>

@using (Html.BeginForm("Create", "GoodsReceiptNote", FormMethod.Post, new { id = "form-create" }))
{
    @Html.AntiForgeryToken()

    <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
        <div>
            <h2 class="mb-0 text-primary fw-bold"><i class="fas fa-file-import me-2"></i>Tạo Phiếu Nhập</h2>
            <small class="text-muted">Nhập hàng vào kho (Chỉ hiển thị SP và NCC đang hoạt động)</small>
        </div>
        <div>
            <a href="@Url.Action("Index")" class="btn btn-light text-secondary fw-bold shadow-sm me-2">
                <i class="fas fa-times me-2"></i>Hủy
            </a>
            <button type="button" class="btn btn-success shadow-sm fw-bold px-4" id="btn-submit">
                <i class="fas fa-save me-2"></i>Lưu Phiếu
            </button>
        </div>
    </div>

    if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger shadow-sm">
            @Html.ValidationSummary(false, "", new { @class = "mb-0" })
        </div>
    }

    <div class="row">
        <div class="col-12 mb-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body">
                    <h5 class="card-title text-primary fw-bold border-bottom pb-2 mb-3">Thông tin phiếu</h5>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label fw-bold text-muted small">Mã phiếu</label>
                            @Html.EditorFor(model => model.GoodsReceiptNoteID, new { htmlAttributes = new { @class = "form-control fw-bold bg-light", @readonly = "readonly" } })
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold text-muted small">Nhà cung cấp <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(model => model.SupplierID, (SelectList)ViewBag.SupplierID, "-- Chọn nhà cung cấp --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.SupplierID, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold text-muted small">Ngày nhập</label>
                            @Html.TextBoxFor(model => model.ReceiptDate, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", @type = "datetime-local", @Value = DateTime.Now.ToString("yyyy-MM-ddTHH:mm") })
                            @Html.ValidationMessageFor(model => model.ReceiptDate, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-2 text-end">
                            <label class="form-label fw-bold text-muted small">Tổng cộng</label>
                            <div class="fs-4 fw-bold text-success" id="display-grand-total">0 đ</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <span class="fw-bold text-secondary">Danh sách hàng hóa</span>
                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3" id="btn-add-row">
                        <i class="fas fa-plus me-1"></i> Thêm dòng
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-input mb-0" id="tbl-details">
                        <thead>
                            <tr>
                                <th style="width: 50px;">Xóa</th>
                                <th style="width: 40%;">Sản phẩm</th>
                                <th style="width: 20%;">Đơn giá vốn</th>
                                <th style="width: 15%;">Số lượng</th>
                                <th style="width: 20%;">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                        <tfoot>
                            <tr class="bg-light fw-bold">
                                <td colspan="4" class="text-end pe-3 text-secondary">TỔNG THÀNH TIỀN:</td>
                                <td class="text-end text-success px-2" id="footer-total">0</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div id="empty-msg" class="text-center text-muted py-4 small">
                    Chưa có sản phẩm nào. Vui lòng bấm "Thêm dòng".
                </div>
            </div>
        </div>
    </div>
}

<div style="display:none;">
    @Html.DropDownList("ProductTemplate", (SelectList)ViewBag.ProductID, "-- Chọn sản phẩm --", new { @id = "product-template-select" })
</div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        var rowIndex = 0; // Biến đếm để tạo name="[0], [1]" cho MVC Binding

        $(document).ready(function () {

            // 1. SỰ KIỆN THÊM DÒNG MỚI
            $('#btn-add-row').click(function () {
                $('#empty-msg').hide(); // Ẩn thông báo trống

                // Lấy HTML các <option> từ cái dropdown ẩn
                var productOptions = $('#product-template-select').html();

                var rowHtml = `
                    <tr class="data-row">
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-danger btn-remove shadow-none" title="Xóa dòng">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </td>
                        <td>
                            <select name="GoodsReceiptNoteDetails[${rowIndex}].ProductID" class="form-select form-select-sm" required>
                                ${productOptions}
                            </select>
                        </td>
                        <td>
                            <input type="number" name="GoodsReceiptNoteDetails[${rowIndex}].UnitPrice"
                                   class="form-control form-control-sm input-number txt-price"
                                   value="0" min="0" placeholder="0" required />
                        </td>
                        <td>
                            <input type="number" name="GoodsReceiptNoteDetails[${rowIndex}].Quantity"
                                   class="form-control form-control-sm input-number txt-qty"
                                   value="1" min="1" placeholder="1" required />
                        </td>
                        <td class="text-end fw-bold text-dark row-total align-middle pe-2">0</td>
                    </tr>
                `;

                $('#tbl-details tbody').append(rowHtml);
                rowIndex++; // Tăng chỉ số
            });

            // 2. TÍNH TIỀN REALTIME (Khi gõ giá hoặc số lượng)
            $(document).on('input', '.txt-price, .txt-qty', function () {
                var row = $(this).closest('tr');
                var price = parseFloat(row.find('.txt-price').val()) || 0;
                var qty = parseFloat(row.find('.txt-qty').val()) || 0;

                var total = price * qty;

                // Format số tiền kiểu VN (1.000.000)
                row.find('.row-total').text(new Intl.NumberFormat('vi-VN').format(total));

                calculateGrandTotal();
            });

            // 3. XÓA DÒNG
            $(document).on('click', '.btn-remove', function () {
                $(this).closest('tr').remove();
                calculateGrandTotal();

                // Nếu xóa hết thì hiện lại thông báo
                if ($('.data-row').length === 0) {
                    $('#empty-msg').show();
                }
            });

            // 4. HÀM TÍNH TỔNG CỘNG CẢ PHIẾU
            function calculateGrandTotal() {
                var grandTotal = 0;
                $('.data-row').each(function () {
                    var price = parseFloat($(this).find('.txt-price').val()) || 0;
                    var qty = parseFloat($(this).find('.txt-qty').val()) || 0;
                    grandTotal += (price * qty);
                });

                var strTotal = new Intl.NumberFormat('vi-VN').format(grandTotal) + ' đ';
                $('#footer-total').text(strTotal);
                $('#display-grand-total').text(strTotal);
            }

            // 5. SUBMIT FORM
            $('#btn-submit').click(function() {
                // Kiểm tra validation cơ bản
                var supplier = $('#SupplierID').val();
                if (!supplier) {
                    Swal.fire('Thiếu thông tin!', 'Vui lòng chọn Nhà cung cấp.', 'warning');
                    return;
                }

                if ($('.data-row').length === 0) {
                    Swal.fire('Chưa có hàng hóa!', 'Vui lòng thêm ít nhất một dòng sản phẩm.', 'warning');
                    return;
                }

                // Submit form thật
                $('#form-create').submit();
            });

            // Tự động thêm 1 dòng khi vào trang cho tiện
            $('#btn-add-row').click();
        });
    </script>