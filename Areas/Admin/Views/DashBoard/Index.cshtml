
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}

<section id="dashboard" class="active-section">
    <h2 class="mb-4">Dashboard</h2>
    <div class="row">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fas fa-basket-shopping me-2"></i>Tổng sản phẩm
                    </h5>
                    <h2>@ViewBag.NoOfProducts</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fas fa-shopping-cart me-2"></i>Tổng đơn hàng
                    </h5>
                    <h2>@ViewBag.NoOfOrders</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fas fa-users me-2"></i>Tổng khách hàng
                    </h5>
                    <h2>@ViewBag.NoOfCustomers</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="fas fa-money-bill-wave me-2"></i>Doanh thu
                    </h5>
                    <h2>@string.Format("{0:N0} đ", ViewBag.Revenue)</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="row mt-5">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-primary">
                        <i class="fas fa-crown text-warning me-2"></i>Top 5 Sản phẩm bán chạy nhất
                    </h5>
                    <small class="text-muted">Dựa trên tổng số lượng đã bán</small>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle table-hover mb-0">
                            <thead class="bg-light text-secondary">
                                <tr>
                                    <th class="text-center" style="width: 50px;">#</th>
                                    <th style="width: 100px;">Hình ảnh</th>
                                    <th>Tên sản phẩm</th>
                                    <th class="text-end">Giá bán</th>
                                    <th class="text-center">Đã bán</th>
                                    <th class="text-end">Doanh thu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var topProducts = ViewBag.Top5Products as List<WebBanHoa.Models.ProductDTO>;
                                }

                                @if (topProducts != null && topProducts.Any())
                                {
                                    int rank = 1;
                                    foreach (var item in topProducts)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                @if (rank == 1)
                                                {
                                                    <span class="badge rounded-pill bg-warning text-dark"><i class="fas fa-trophy"></i> 1</span>
                                                }
                                                else if (rank == 2)
                                                {
                                                    <span class="badge rounded-pill bg-secondary bg-opacity-50 text-dark">2</span>
                                                }
                                                else if (rank == 3)
                                                {
                                                    <span class="badge rounded-pill bg-secondary bg-opacity-25 text-dark">3</span>
                                                }
                                                else
                                                {
                                                    <span class="fw-bold text-muted">@rank</span>
                                                }
                                            </td>

                                            <td>
                                                <div class="rounded-3 overflow-hidden border" style="width: 60px; height: 60px;">
                                                    <img src="@Url.Content("~/Content/Images/" + item.Image)"
                                                         alt="@item.ProductName"
                                                         class="w-100 h-100 object-fit-cover"
                                                         onerror="this.src='https://via.placeholder.com/60'" />
                                                </div>
                                            </td>

                                            <td>
                                                <div class="fw-bold text-dark">@item.ProductName</div>
                                            </td>

                                            <td class="text-end text-muted">
                                                @string.Format("{0:N0} đ", item.Price)
                                            </td>

                                            <td class="text-center">
                                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                                                    @item.TotalSold
                                                </span>
                                            </td>

                                            <td class="text-end fw-bold text-primary">
                                                @string.Format("{0:N0} đ", item.TotalRevenue)
                                            </td>
                                        </tr>
                                        rank++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            Chưa có dữ liệu bán hàng.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

