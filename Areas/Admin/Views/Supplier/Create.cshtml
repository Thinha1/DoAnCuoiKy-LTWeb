@model WebBanHoa.Models.Supplier

@{
    ViewBag.Title = "Thêm mới nhà cung cấp";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Supplier")" class="text-decoration-none text-muted">Nhà cung cấp</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
            </ol>
        </nav>
        <h2 class="mb-0 text-primary fw-bold"><i class="fas fa-plus-circle me-2"></i>Thêm Nhà cung cấp</h2>
    </div>
</div>

@* Hiển thị thông báo lỗi chung nếu có *@
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger shadow-sm border-0 border-start border-4 border-danger">
        @Html.ValidationSummary(false, "", new { @class = "mb-0" })
    </div>
}

<div class="card border-0 shadow-sm" style="border-radius: 10px;">
    <div class="card-body p-4">
        @using (Html.BeginForm("Create", "Supplier", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="row g-4">
                @* --- CỘT TRÁI: THÔNG TIN CƠ BẢN --- *@
                <div class="col-md-6">
                    <h5 class="text-muted mb-3 border-bottom pb-2 text-uppercase fs-6 fw-bold">Thông tin cơ bản</h5>

                    @* Mã NCC (Readonly) *@
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">Mã Nhà cung cấp <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0"><i class="fas fa-barcode"></i></span>
                            @Html.EditorFor(model => model.SupplierID, new { htmlAttributes = new { @class = "form-control bg-light text-primary fw-bold", @readonly = "readonly" } })
                        </div>
                        <small class="text-muted fst-italic">Mã được sinh tự động, không thể chỉnh sửa.</small>
                    </div>

                    @* Tên NCC *@
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">Tên Nhà cung cấp <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted border-end-0"><i class="fas fa-building"></i></span>
                            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên công ty/vườn hoa..." } })
                        </div>
                        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger small mt-1" })
                    </div>
                </div>

                @* --- CỘT PHẢI: THÔNG TIN LIÊN HỆ --- *@
                <div class="col-md-6">
                    <h5 class="text-muted mb-3 border-bottom pb-2 text-uppercase fs-6 fw-bold">Thông tin liên hệ</h5>

                    @* Số điện thoại *@
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">Số điện thoại</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted border-end-0"><i class="fas fa-phone"></i></span>
                            @* Giả sử model có trường Phone, nếu chưa có thì thêm vào Model Supplier *@
                            @Html.Editor("Phone", new { htmlAttributes = new { @class = "form-control", placeholder = "VD: 0987..." } })
                        </div>
                    </div>

                    @* Email *@
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted border-end-0"><i class="fas fa-envelope"></i></span>
                            @Html.Editor("Email", new { htmlAttributes = new { @class = "form-control", placeholder = "contact@example.com" } })
                        </div>
                    </div>

                    @* Địa chỉ *@
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">Địa chỉ</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted border-end-0"><i class="fas fa-map-marker-alt"></i></span>
                            @Html.Editor("Address", new { htmlAttributes = new { @class = "form-control", placeholder = "Địa chỉ trụ sở/kho hàng..." } })
                        </div>
                    </div>
                </div>
            </div>

            @* --- NÚT BẤM --- *@
            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a href="@Url.Action("Index")" class="btn btn-light px-4 border shadow-sm">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại
                </a>
                <button type="submit" class="btn btn-primary px-4 shadow-sm fw-bold">
                    <i class="fas fa-save me-1"></i> Lưu thông tin
                </button>
            </div>
        }
    </div>
</div>