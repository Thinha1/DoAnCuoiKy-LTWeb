@model WebBanHoa.Models.Supplier

@{
    ViewBag.Title = "Cập nhật nhà cung cấp";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center my-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Supplier")" class="text-decoration-none text-muted">Nhà cung cấp</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Cập nhật</li>
                </ol>
            </nav>
            <h2 class="mb-0 text-primary fw-bold"><i class="fas fa-edit me-2"></i>Cập nhật thông tin</h2>
        </div>
        <a href="@Url.Action("Index", "Supplier", new {area = "Admin"})" class="btn btn-secondary shadow-sm">
            <i class="fas fa-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <i class="fas fa-pen-to-square me-1 text-primary"></i>
            <span class="fw-bold text-secondary">Thông tin đối tác: <span class="text-danger">@Model.Name</span></span>
        </div>
        <div class="card-body p-4">

            @using (Html.BeginForm("Edit", "Supplier", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(model => model.SupplierID)

                <div class="row">
                    <div class="col-md-8">

                        <div class="mb-3">
                            @Html.LabelFor(model => model.SupplierID, "Mã Nhà cung cấp", htmlAttributes: new { @class = "form-label fw-bold" })
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="fas fa-barcode"></i></span>
                                @Html.EditorFor(model => model.SupplierID, new { htmlAttributes = new { @class = "form-control bg-light fw-bold text-secondary", @readonly = "readonly" } })
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.Name, "Tên Nhà cung cấp", htmlAttributes: new { @class = "form-label fw-bold" })
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fas fa-building text-secondary"></i></span>
                                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control", @required = "required" } })
                            </div>
                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.Address, "Địa chỉ trụ sở/Kho hàng", htmlAttributes: new { @class = "form-label fw-bold" })
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fas fa-map-marker-alt text-secondary"></i></span>
                                @Html.TextAreaFor(model => model.Address, new { @class = "form-control", @rows = "3" })
                            </div>
                            @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card bg-light border-0 mb-3">
                            <div class="card-header bg-transparent fw-bold text-uppercase small text-muted">
                                <i class="fas fa-address-book me-1"></i> Liên hệ
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    @Html.LabelFor(model => model.Phone, "Số điện thoại", htmlAttributes: new { @class = "form-label fw-bold small" })
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-white"><i class="fas fa-phone text-success"></i></span>
                                        @Html.EditorFor(model => model.Phone, new { htmlAttributes = new { @class = "form-control" } })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger" })
                                </div>

                                <div class="mb-3">
                                    @Html.LabelFor(model => model.Email, "Email", htmlAttributes: new { @class = "form-label fw-bold small" })
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-white"><i class="fas fa-envelope text-warning"></i></span>
                                        @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", @type = "email" } })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="card border-0 shadow-sm">
                            <div class="card-body bg-light text-muted small">
                                <div class="d-flex justify-content-between mb-2">
                                    <span><i class="far fa-calendar-plus me-1"></i> Ngày tạo:</span>
                                    <span class="fw-bold">
                                        @(Model.CreatedAt.HasValue ? Model.CreatedAt.Value.ToString("dd/MM/yyyy HH:mm") : "---")
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span><i class="far fa-clock me-1"></i> Cập nhật cuối:</span>
                                    <span class="fw-bold">
                                        @(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("dd/MM/yyyy") : DateTime.Now.ToString("dd/MM/yyyy"))
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                    <a href="@Url.Action("Index", "Supplier", new {area = "Admin"})" class="btn btn-light border me-2">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                        <i class="fas fa-save me-2"></i>Cập nhật
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Script {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
}