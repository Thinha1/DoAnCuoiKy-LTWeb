@model List<WebBanHoa.Models.OrderDTO>
@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}

<style>
    /* 1. Tinh chỉnh trạng thái (Status Badge) */
    .status-badge {
        font-weight: 700;
        padding: 0.5em 0.8em;
        border-radius: 0.375rem;
        font-size: 0.8rem;
        display: inline-block;
        min-width: 100px;
        text-align: center;
    }

    /* 2. Căn giữa nội dung */
    .table.align-middle td,
    .table.align-middle th {
        vertical-align: middle;
    }

    /* 3. Style cho tiêu đề bảng */
    .admin-table thead th {
        background-color: #f8f9fa; /* Màu nền xám rất nhạt */
        color: #6c757d; /* Màu chữ xám đậm */
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase; /* Chữ in hoa */
        border-bottom: 2px solid #dee2e6;
        padding-top: 1rem;
        padding-bottom: 1rem;
    }

    /* 4. Hiệu ứng khi di chuột vào hàng */
    .admin-table tbody tr:hover {
        background-color: #fdfdfd;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Quản lý đơn hàng</h2>
    <a class="btn btn-primary" href="@Url.Action("Create", "Order")">
        <i class="fas fa-plus me-2"></i>Tạo đơn hàng mới
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle admin-table mb-0">
        <thead>
            <tr>
                <th style="width: 10%;">Mã ĐH</th>
                <th style="width: 15%;">Tên khách hàng</th>
                <th style="width: 15%;">Ngày đặt</th>
                <th style="width: 25%;">Địa chỉ giao hàng</th>
                <th style="width: 15%;">Trạng thái</th>
                <th class="text-center" style="width: 10%;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var od in Model)
                {
                    <tr>
                        <td><strong>#@od.OrderID</strong></td>
                        <td>@od.CustomerName</td>
                        <td>@od.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@od.Address</td>
                        <td>
                            @od.Status
                        </td>
                        <td class="text-center">
                            <a href="@Url.Action("Details", "Order", new { orderID = od.OrderID, area = "Admin" })"
                               class="btn btn-sm btn-outline-info"
                               title="Xem chi tiết">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="@Url.Action("Edit", "Order", new { orderID = od.OrderID, area = "Admin" })"
                               class="btn btn-sm btn-outline-primary ms-1"
                               title="Cập nhật">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a href="@Url.Action("Delete", "Order", new { orderID = od.OrderID, area = "Admin" })"
                               class="btn btn-sm btn-outline-danger ms-1 delete-btn"
                               title="Xóa/Hủy">
                                <i class="fas fa-times"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center py-4 text-muted">Không có đơn hàng nào được tìm thấy.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section Script{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Logic SweetAlert cho nút Xóa/Hủy
            $('.delete-btn').on('click', function (e) {
                e.preventDefault();

                var self = $(this);
                var deleteUrl = self.attr('href');

                Swal.fire({
                    title: 'Bạn có chắc chắn muốn HỦY đơn hàng này?',
                    text: "Đơn hàng này sẽ bị hủy và không thể khôi phục!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Hủy đơn hàng',
                    cancelButtonText: 'Đóng'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Chuyển trang/Gọi API Hủy đơn hàng
                        window.location.href = deleteUrl;
                    }
                });
            });
        });
    </script>
}