@model List<WebBanHoa.Models.OrderDTO>
@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}

<style>
    /* Style bổ sung cho bảng */
    .admin-table thead th {
        background-color: #f8f9fa;
        color: #6c757d;
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        border-bottom: 2px solid #dee2e6;
        padding-top: 1rem;
        padding-bottom: 1rem;
    }

    .admin-table tbody tr:hover {
        background-color: #fdfdfd;
    }

    /* Badge cho phương thức thanh toán */
    .badge-payment-cod {
        background-color: #6c757d; /* Màu xám cho COD */
        color: white;
    }

    .badge-payment-banking {
        background-color: #0d6efd; /* Màu xanh dương cho CK */
        color: white;
    }

    .badge-payment-momo {
        background-color: #d63384; /* Màu hồng cho Momo */
        color: white;
    }

    .search-form .form-control {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

    .search-form .btn {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Quản lý đơn hàng</h2>
    @using (Html.BeginForm("Index", "Order", FormMethod.Get, new { @class = "d-flex search-form me-3" }))
    {
        <div class="input-group">
            <input type="text" name="TuKhoa" class="form-control"
                   placeholder="Nhập mã đơn hàng hoặc tên khách..."
                   value="@ViewBag.CurrentFilter">
            <button class="btn btn-outline-secondary" type="submit">
                <i class="fas fa-search"></i>
            </button>
        </div>
    }
</div>
<p class="text-danger">@TempData["Error"]</p>
<p class="text-success">@TempData["Success"]</p>
<div class="table-responsive">
    <table class="table table-hover align-middle admin-table mb-0">
        <thead>
            <tr>
                <th style="width: 8%;">Mã ĐH</th>
                <th style="width: 15%;">Tên khách hàng</th>
                <th style="width: 12%;">Ngày đặt</th>
                <th style="width: 20%;">Địa chỉ giao hàng</th>
                <th style="width: 12%;">Thanh toán</th>
                <th style="width: 13%;">Trạng thái</th>
                <th class="text-center" style="width: 20%;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var od in Model)
                {
                    <tr>
                        <td><strong>#@od.OrderID</strong></td>
                        <td>@od.CustomerName</td>
                        <td>@od.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <span class="text-truncate d-inline-block" style="max-width: 200px;" title="@od.Address">
                                @od.Address
                            </span>
                        </td>

                        <td>
                            @if (!string.IsNullOrEmpty(od.UserPaymentMethod))
                            {
                                // Xử lý hiển thị badge tùy theo loại thanh toán
                                string badgeClass = "badge bg-secondary";
                                string icon = "fas fa-money-bill-wave";

                                if (od.UserPaymentMethod.Contains("Chuyển khoản"))
                                {
                                    badgeClass = "badge bg-primary"; // Màu xanh
                                    icon = "fas fa-university";
                                }

                                <span class="@badgeClass p-2 rounded">
                                    <i class="@icon me-1"></i> @od.UserPaymentMethod
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">---</span>
                            }
                        </td>

                        <td>
                            @{
                                string statusClass = "text-secondary";
                                if (od.Status == "Đã giao") { statusClass = "text-success fw-bold"; }
                                else if (od.Status == "Đang giao") { statusClass = "text-info fw-bold"; }
                                else if (od.Status == "Đã huỷ") { statusClass = "text-danger"; }
                            }
                            <span class="@statusClass">@od.Status</span>
                        </td>

                        <td class="text-center">
                            <a href="@Url.Action("Details", "Order", new { orderID = od.OrderID, area = "Admin" })"
                               class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="@Url.Action("Edit", "Order", new { orderID = od.OrderID, area = "Admin" })"
                               class="btn btn-sm btn-outline-primary ms-1" title="Cập nhật">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a href="@Url.Action("CancelOrder", "Order", new { orderID = od.OrderID, area = "Admin" })"
                               class="btn btn-sm btn-outline-danger ms-1 delete-btn" title="Xóa/Hủy">
                                <i class="fas fa-times"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">Không có đơn hàng nào được tìm thấy.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Script{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Logic SweetAlert cho nút Xóa/Hủy
            $('.delete-btn').on('click', function (e) {
                e.preventDefault();
                var self = $(this);
                var deleteUrl = self.attr('href');

                Swal.fire({
                    title: 'Bạn có chắc chắn muốn HỦY đơn hàng này?',
                    text: "Đơn hàng này sẽ bị hủy và không thể khôi phục!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Hủy đơn hàng',
                    cancelButtonText: 'Đóng'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = deleteUrl;
                    }
                });
            });
        });
    </script>
}