@model WebBanHoa.Models.DiscountDTO

@{
    ViewBag.Title = "Thêm mới giảm giá";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <div>
        <h2 class="mb-0 text-primary fw-bold">
            <i class="fas fa-plus-circle me-2"></i>Thêm Mã Giảm Giá Mới
        </h2>
        <small class="text-muted">Tạo chương trình khuyến mãi cho sản phẩm</small>
    </div>
    <div>
        <a href="@Url.Action("Index")" class="btn btn-light text-secondary fw-bold shadow-sm">
            <i class="fas fa-times me-2"></i>Hủy bỏ
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-10">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="mb-0 fw-bold text-secondary">Thông tin chương trình</h5>
            </div>

            <div class="card-body p-4">
                @using (Html.BeginForm("Create", "Discount", FormMethod.Post, new { id = "createDiscountForm" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.DiscountID)

                    if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger shadow-sm">
                            @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small">Sản phẩm áp dụng <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(model => model.ProductID, (SelectList)ViewBag.ProductList, "-- Chọn sản phẩm --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.ProductID, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small">Tên chương trình <span class="text-danger">*</span></label>
                            @Html.EditorFor(model => model.DiscountName, new { htmlAttributes = new { @class = "form-control", @placeholder = "VD: Sale tưng bừng 2/9..." } })
                            @Html.ValidationMessageFor(model => model.DiscountName, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold text-muted small">Mức giảm (%) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                @Html.EditorFor(model => model.DiscountRate, new { htmlAttributes = new { @class = "form-control fw-bold text-primary", @type = "number", @min = "1", @max = "100", @placeholder = "10" } })
                                <span class="input-group-text bg-light fw-bold text-muted">%</span>
                            </div>
                            @Html.ValidationMessageFor(model => model.DiscountRate, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold text-muted small">Ngày bắt đầu</label>
                            @Html.TextBoxFor(model => model.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", @id = "StartDate", @Value = DateTime.Now.ToString("yyyy-MM-dd") })
                            @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold text-muted small">Ngày kết thúc</label>
                            @Html.TextBoxFor(model => model.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", @id = "EndDate" })
                            @Html.ValidationMessageFor(model => model.EndDate, "", new { @class = "text-danger small" })

                            <small id="dateError" class="text-danger d-none mt-1">
                                <i class="fas fa-exclamation-triangle me-1"></i>Ngày kết thúc phải lớn hơn ngày bắt đầu!
                            </small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <a href="@Url.Action("Index")" class="btn btn-light border me-2 fw-bold text-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm">
                            <i class="fas fa-plus me-2"></i>Thêm mới
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

    <script>
        $(document).ready(function () {
            // Validate Ngày tháng
            $('#createDiscountForm').submit(function (e) {
                var startDateStr = $('#StartDate').val();
                var endDateStr = $('#EndDate').val();

                if (startDateStr && endDateStr) {
                    var startDate = new Date(startDateStr);
                    var endDate = new Date(endDateStr);

                    if (endDate < startDate) {
                        e.preventDefault();
                        $('#dateError').removeClass('d-none');
                        $('#EndDate').addClass('is-invalid');
                        $('#EndDate').focus();
                    } else {
                        $('#dateError').addClass('d-none');
                        $('#EndDate').removeClass('is-invalid');
                    }
                }
            });

            // Clear lỗi khi đổi ngày
            $('#EndDate, #StartDate').change(function () {
                $('#dateError').addClass('d-none');
                $('#EndDate').removeClass('is-invalid');
            });
        });
    </script>