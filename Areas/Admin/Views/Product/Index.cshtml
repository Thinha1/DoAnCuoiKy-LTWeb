@model List<WebBanHoa.Models.ProductDTO>
@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}

<style>
    /* --- 1. COPY STYLE TỪ TRANG ORDER ĐỂ ĐỒNG BỘ --- */
    .table-container {
        background-color: #fff;
        border-radius: 10px;
        box-shadow: 0 0 15px rgba(0,0,0,0.05);
        overflow: hidden;
        padding: 0;
    }

    .admin-table thead th {
        background-color: #f1f5f9; /* Màu nền header giống Order */
        color: #475569;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        border-bottom: 2px solid #e2e8f0;
        padding: 15px 10px;
        white-space: nowrap;
    }

    .admin-table tbody tr {
        transition: all 0.2s;
    }

        .admin-table tbody tr:hover {
            background-color: #f8fafc;
            transform: translateY(-1px);
        }

    .admin-table td {
        padding: 12px 10px;
        vertical-align: middle;
        font-size: 0.9rem;
        border-bottom: 1px solid #f1f5f9;
    }

    /* Form tìm kiếm bo tròn */
    .search-form .form-control {
        border-radius: 20px 0 0 20px;
        border: 1px solid #ced4da;
        padding-left: 20px;
    }

    .search-form .btn {
        border-radius: 0 20px 20px 0;
        padding-left: 20px;
        padding-right: 20px;
    }

    /* --- 2. STYLE RIÊNG CHO SẢN PHẨM --- */

    /* Ảnh đại diện sản phẩm */
    .product-thumbnail {
        width: 48px;
        height: 48px;
        object-fit: cover;
        border-radius: 8px; /* Bo góc mềm mại hơn */
        border: 1px solid #e2e8f0;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }

    /* Tên sản phẩm */
    .product-name {
        font-weight: 600;
        color: #334155;
        display: block;
    }

    /* Giá tiền */
    .product-price {
        font-weight: 700;
        color: #0d9488; /* Màu xanh teal sang trọng */
        font-family: monospace;
        font-size: 0.95rem;
    }

    /* Badge trạng thái (Style Pill) */
    .status-badge {
        padding: 5px 12px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .status-active {
        background-color: #dcfce7;
        color: #166534; /* Xanh lá */
    }

    .status-disabled {
        background-color: #f3f4f6;
        color: #6b7280; /* Xám */
    }

    /* --- 3. LOGIC KHI NGỪNG KINH DOANH --- */
    .row-disabled {
        background-color: #f9fafb !important;
    }

        .row-disabled td {
            opacity: 0.6;
        }

        /* Ngoại trừ cột thao tác và hình ảnh thì không làm mờ quá nhiều */
        .row-disabled .no-dim {
            opacity: 1 !important;
        }

        .row-disabled .product-name {
            text-decoration: line-through;
            color: #9ca3af;
        }

        .row-disabled .product-thumbnail {
            filter: grayscale(100%);
        }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <div>
        <h2 class="mb-0 text-primary fw-bold"><i class="fas fa-seedling me-2"></i>Quản lý hoa</h2>
        <small class="text-muted">Danh sách sản phẩm đang kinh doanh tại cửa hàng</small>
    </div>

    <div class="d-flex gap-2">
        @* Nút thêm mới *@
        <a href="@Url.Action("Create", "Product")" class="btn btn-primary shadow-sm rounded-pill px-3">
            <i class="fas fa-plus me-1"></i> Thêm sản phẩm
        </a>

        @* Form tìm kiếm *@
        @using (Html.BeginForm("Index", "Product", FormMethod.Get, new { @class = "d-flex search-form" }))
        {
            <div class="input-group shadow-sm">
                <input type="text" name="TuKhoa" class="form-control border-end-0"
                       placeholder="Tìm tên hoa, chủ đề..."
                       value="@ViewBag.CurrentFilter">
                <button class="btn btn-white border border-start-0 text-secondary bg-white hover-primary" type="submit">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        }
    </div>
</div>

@* Thông báo *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success shadow-sm border-0 border-start border-4 border-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger shadow-sm border-0 border-start border-4 border-danger">@TempData["Error"]</div>
}

<div class="table-container">
    <div class="table-responsive">
        <table class="table align-middle admin-table mb-0">
            <thead>
                <tr>
                    <th style="width: 8%;">Hình ảnh</th>
                    <th style="width: 25%;">Tên sản phẩm</th>
                    <th style="width: 15%;">Loại / Chủ đề</th>
                    <th style="width: 15%;">Giá bán</th>
                    <th style="width: 10%;">Tồn kho</th>
                    <th style="width: 12%;">Trạng thái</th>
                    <th class="text-center" style="width: 15%;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var sp in Model)
                    {
                        // Logic kiểm tra trạng thái
                        bool isActive = sp.IsAvailable == 1;
                        string rowClass = isActive ? "" : "row-disabled";

                        <tr class="@rowClass">
                            @* 1. Hình ảnh *@
                            <td class="no-dim">
                                <img src="@Url.Content("~/Content/Images/" + sp.Image)"
                                     alt="@sp.ProductName"
                                     class="product-thumbnail"
                                     onerror="this.src='/Content/Images/no-image.png'" />
                            </td>

                            @* 2. Tên sản phẩm *@
                            <td>
                                <span class="product-name">@sp.ProductName</span>
                            </td>

                            @* 3. Phân loại *@
                            <td>
                                <div class="d-flex flex-column">
                                    <span class="text-dark fw-bold" style="font-size: 0.85rem;">@sp.CategoryName</span>
                                    <span class="text-muted small">@sp.ThemeName</span>
                                </div>
                            </td>

                            @* 4. Giá *@
                            <td>
                                <span class="product-price">@String.Format("{0:N0}", sp.Price) ₫</span>
                            </td>

                            @* 5. Số lượng *@
                            <td>
                                @if (sp.Quantity > 0)
                                {
                                    <span class="fw-bold text-dark">@sp.Quantity</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Hết hàng</span>
                                }
                            </td>

                            @* 6. Trạng thái *@
                            <td class="no-dim">
                                @if (isActive)
                                {
                                    <span class="status-badge status-active">
                                        <i class="fas fa-check-circle"></i> Đang bán
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-disabled">
                                        <i class="fas fa-lock"></i> Ngừng bán
                                    </span>
                                }
                            </td>

                            @* 7. Thao tác *@
                            <td class="text-center no-dim">
                                <div class="btn-group shadow-sm" role="group">
                                    @* Nút Xem *@
                                    <a href="@Url.Action("Details", "Home", new { productID = sp.ProductID, area = "" })"
                                       class="btn btn-sm btn-light text-info"
                                       title="Xem ngoài trang chủ" target="_blank">
                                        <i class="fas fa-eye"></i>
                                    </a>

                                    @* Nút Sửa *@
                                    <a href="@Url.Action("Edit", "Product", new { productID = sp.ProductID, area = "Admin" })"
                                       class="btn btn-sm btn-light text-primary" title="Cập nhật">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    @* Nút Khóa / Mở Khóa *@
                                    @if (isActive)
                                    {
                                        <a href="@Url.Action("DisableProduct", "Product", new { productID = sp.ProductID, area = "Admin" })"
                                           class="btn btn-sm btn-light text-danger confirm-action"
                                           data-type="lock"
                                           data-name="@sp.ProductName"
                                           title="Ngừng kinh doanh">
                                            <i class="fas fa-lock"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("EnableProduct", "Product", new { productID = sp.ProductID, area = "Admin" })"
                                           class="btn btn-sm btn-light text-success confirm-action"
                                           data-type="unlock"
                                           data-name="@sp.ProductName"
                                           title="Mở bán lại">
                                            <i class="fas fa-unlock"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="text-muted">
                                <i class="fas fa-leaf fa-3x mb-3 opacity-25"></i>
                                <p>Không tìm thấy sản phẩm nào.</p>
                                <a href="@Url.Action("Create", "Product")" class="btn btn-sm btn-outline-primary mt-2">
                                    Thêm sản phẩm mới
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Script{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Hiệu ứng hover cho nút tìm kiếm
            $('.btn-white').hover(
                function () { $(this).addClass('bg-light'); },
                function () { $(this).removeClass('bg-light'); }
            );

            // Xử lý SweetAlert cho nút Khóa/Mở khóa
            $('.confirm-action').on('click', function (e) {
                e.preventDefault();
                var self = $(this);
                var url = self.attr('href');
                var name = self.data('name');
                var type = self.data('type');

                // Cấu hình nội dung thông báo
                var title = "";
                var text = "";
                var icon = "";
                var confirmBtnColor = "";
                var confirmBtnText = "";

                if (type === 'lock') {
                    title = 'Ngừng kinh doanh?';
                    text = "Sản phẩm \"" + name + "\" sẽ bị ẩn khỏi trang chủ!";
                    icon = 'warning';
                    confirmBtnColor = '#dc3545'; // Đỏ
                    confirmBtnText = 'Vâng, khóa ngay';
                } else {
                    title = 'Mở bán lại?';
                    text = "Sản phẩm \"" + name + "\" sẽ hiển thị lại cho khách mua.";
                    icon = 'question';
                    confirmBtnColor = '#10b981'; // Xanh ngọc
                    confirmBtnText = 'Đồng ý mở lại';
                }

                Swal.fire({
                    title: title,
                    text: text,
                    icon: icon,
                    showCancelButton: true,
                    confirmButtonColor: confirmBtnColor,
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: confirmBtnText,
                    cancelButtonText: 'Hủy bỏ',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            });
        });
    </script>
}