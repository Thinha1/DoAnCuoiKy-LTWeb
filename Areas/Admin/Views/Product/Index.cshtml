@model List<WebBanHoa.Models.ProductDTO>
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/Admin_Layout.cshtml";
}
<style>
    /* Class để giới hạn kích thước ảnh thumbnail trong bảng */
    .product-thumbnail {
        width: 80px;
        height: 80px;
        object-fit: cover; /* Đảm bảo ảnh lấp đầy mà không bị méo */
        border-radius: 4px;
        border: 1px solid #ddd;
    }

    /* Căn giữa nội dung trong bảng theo chiều dọc */
    .table.align-middle td,
    .table.align-middle th {
        vertical-align: middle;
    }

    /* Giới hạn độ dài của cột mô tả */
    .description-cell {
        max-width: 250px; /* Đặt chiều rộng tối đa */
        white-space: nowrap; /* Ngăn không cho xuống dòng */
        overflow: hidden; /* Ẩn phần thừa */
        text-overflow: ellipsis; /* Thêm dấu "..." */
    }
</style>
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Quản lý hoa</h2>
    <a class="btn btn-primary" href="@Url.Action("Create", "Product")">
        <i class="fas fa-plus me-2"></i>Thêm sản phẩm
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle text-center">
        <thead>
            <tr>
                <th style="width: 20%;">Tên sản phẩm</th>
                <th style="width: 15%;">Loại hoa</th>
                <th style="width: 15%;">Chủ đề</th>
                <th style="width: 10%;">Giá</th>
                <th style="width: 10%;">Số lượng</th>
                <th style="width: 10%;">Hình ảnh</th>
                <th class="text-center" style="width: 150px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sp in Model)
            {
                <tr>
                    <td>@sp.ProductName</td>
                    <td>@sp.CategoryName</td>
                    <td>@sp.ThemeName</td>
                    <td>@String.Format("{0:N0}", sp.Price) VNĐ</td>
                    <td>@sp.Quantity</td>

                    <td>
                        <img src="@Url.Content("~/Content/Images/" + sp.Image)"
                             alt="@sp.ProductName"
                             class="product-thumbnail" />
                    </td>
                    <td class="text-center">
                        <a href="@Url.Action("Edit", "Product", new { productID = sp.ProductID, area = "Admin" })" class="btn btn-sm btn-outline-primary" title="Sửa">
                            <i class="fas fa-pencil-alt"></i>
                        </a>
                        <a href="@Url.Action("Details", "Product", new { productID = sp.ProductID, area = "" })"
                           class="btn btn-sm btn-outline-info"
                           title="Xem chi tiết">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a href="@Url.Action("Delete", "Product", new { productID = sp.ProductID, area = "Admin" })" class="btn btn-sm btn-outline-danger" title="Xóa">
                            <i class="fas fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
