@model WebBanHoa.Models.CartDTO
@using System.Web.Mvc;

@{
    ViewBag.Title = "Thanh Toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userName = ViewBag.UserName as string;
    var userAddress = ViewBag.UserAddress as string;
    var userEmail = ViewBag.UserEmail as string;

    decimal totalAmount = 0;
    int totalQuantity = 0;

    if (Model != null && Model.Items != null)
    {
        foreach (var item in Model.Items)
        {
            decimal price = item.Price;
            decimal discountRate = item.DiscountRate;
            int quantity = item.Quantity ?? 0;
            decimal discountedPrice = price - (price * discountRate / 100);
            totalAmount += discountedPrice * quantity;
            totalQuantity += quantity;
        }
    }
}

<style>
    /* CSS cho các lựa chọn thanh toán đẹp hơn */
    .payment-option-card {
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 10px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
    }

        .payment-option-card:hover {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .payment-option-card.selected {
            border-color: #28a745;
            background-color: #f0fff4;
        }

    .payment-logo {
        width: 40px;
        height: 40px;
        object-fit: contain;
        margin-right: 15px;
    }

    .product-img-mini {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 5px;
        margin-right: 10px;
    }

    .sticky-card {
        max-height: calc(100vh - 150px);
        overflow-y: auto;
    }
</style>

<div class="container py-5">
    <h1 class="text-center mb-4">THANH TOÁN ĐƠN HÀNG</h1>

    @if (Model == null || !Model.Items.Any())
    {
        <div class="alert alert-info text-center py-4">
            <h4>Giỏ hàng trống</h4>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">Mua sắm ngay</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h3 class="card-title text-danger mb-4"><i class="fas fa-map-marker-alt me-2"></i>Thông tin giao hàng</h3>

                        @using (Html.BeginForm("ThanhToan", "Orders", FormMethod.Post, new { id = "checkoutForm", @class = "needs-validation" }))
                        {
                            @Html.AntiForgeryToken()

                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Họ tên <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" name="CustomerName" value="@userName" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                                    <input type="tel" class="form-control" name="Phone" required pattern="(09|03|07|08|05)[0-9]{8}">
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-bold">Địa chỉ <span class="text-danger">*</span></label>
                                    <textarea class="form-control" name="Address" required>@userAddress</textarea>
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-control" name="Email" value="@userEmail">
                                </div>
                            </div>

                            <h5 class="mb-3 fw-bold"><i class="fas fa-credit-card me-2"></i>Phương thức thanh toán</h5>

                            <label class="payment-option-card" for="cod">
                                <input class="form-check-input mt-0 me-3" type="radio" name="PaymentMethod" id="cod" value="Thanh toán khi nhận hàng (COD)" checked>
                                <i class="fas fa-money-bill-wave fa-2x text-secondary me-3" style="width:40px"></i>
                                <div>
                                    <div class="fw-bold">Thanh toán khi nhận hàng (COD)</div>
                                    <small class="text-muted">Trả tiền mặt khi shipper giao hàng</small>
                                </div>
                            </label>

                            <label class="payment-option-card" for="vietqr">
                                <input class="form-check-input mt-0 me-3" type="radio" name="PaymentMethod" id="vietqr" value="Chuyển khoản">
                                <img src="@Url.Content("~/Content/Images/vietqr.jpg")" class="payment-logo" style="background:#fff; border-radius:4px;" alt="VietQR">
                                <div>
                                    <div class="fw-bold">Chuyển khoản nhanh (VietQR)</div>
                                    <small class="text-muted">Quét mã QR mọi ngân hàng</small>
                                </div>
                            </label>

                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-danger btn-lg py-3">
                                    <i class="fas fa-check-circle me-2"></i> HOÀN TẤT ĐẶT HÀNG
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm border-0 sticky-card">
                    <div class="card-body p-4">
                        <h3 class="card-title text-danger mb-4">Tóm tắt đơn hàng</h3>
                        <div class="d-flex justify-content-between mt-3 pt-3 border-top fw-bold fs-5">
                            <span>Tổng thanh toán:</span>
                            <span class="text-danger">@String.Format("{0:N0}", totalAmount) VNĐ</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script>
    // Script đổi nội dung nút bấm
    const btnSubmit = document.querySelector('button[type="submit"]');
    const radioInputs = document.querySelectorAll('input[name="PaymentMethod"]');

    function updateButtonText() {
        const selected = document.querySelector('input[name="PaymentMethod"]:checked').value;
        if (selected === "VietQR") {
            btnSubmit.innerHTML = '<i class="fas fa-qrcode me-2"></i> ĐẶT HÀNG & LẤY MÃ QR';
            btnSubmit.classList.remove('btn-danger');
            btnSubmit.classList.add('btn-primary'); // Đổi màu xanh cho thân thiện
        } else {
            btnSubmit.innerHTML = '<i class="fas fa-check-circle me-2"></i> HOÀN TẤT ĐẶT HÀNG';
            btnSubmit.classList.remove('btn-primary');
            btnSubmit.classList.add('btn-danger');
        }
    }

    radioInputs.forEach(input => {
        input.addEventListener('change', updateButtonText);
    });
</script>