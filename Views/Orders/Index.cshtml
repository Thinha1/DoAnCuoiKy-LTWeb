
@model List<WebBanHoa.Models.Order>

@{
    ViewBag.Title = "Đơn Hàng Của Tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <h1 class="mb-4">ĐƠN HÀNG CỦA TÔI</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-inbox fs-1"></i>
            <h4 class="mt-3">Bạn chưa có đơn hàng nào</h4>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">
                <i class="bi bi-shop"></i> Mua sắm ngay
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Thanh toán</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>
                                <strong>@order.OrderID</strong>
                            </td>
                            <td>
                                @(order.OrderDate?.ToString("dd/MM/yyyy HH:mm"))
                            </td>
                            <td class="fw-bold text-danger">
                                @String.Format("{0:N0}", ViewData[$"Total_{order.OrderID}"]) VNĐ
                            </td>
                            <td>
                                @if (order.Status == "Chờ xác nhận")
                                {
                                    <span class="badge bg-warning">@order.Status</span>
                                }
                                else if (order.Status == "Đã giao")
                                {
                                    <span class="badge bg-success">@order.Status</span>
                                }
                                else if (order.Status == "Đang giao")
                                {
                                    <span class="badge bg-primary">@order.Status</span>
                                }
                                else if (order.Status == "Đã hủy")
                                {
                                    <span class="badge bg-secondary">@order.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">@order.Status</span>
                                }
                            </td>
                            <td>@order.UserPaymentMethod</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("Details", "Orders", new { id = order.OrderID.Trim() })"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> Chi tiết
                                    </a>

                                    @if (order.Status == "Chờ xác nhận")
                                    {
                                        using (Html.BeginForm("HuyDon", "Orders", new { id = order.OrderID.Trim() }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Bạn có chắc muốn hủy đơn hàng này?')">
                                                <i class="bi bi-x-circle"></i> Hủy
                                            </button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-4">
            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Tiếp tục mua sắm
            </a>
        </div>
    }
</div>

<!-- Hiển thị thông báo -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}