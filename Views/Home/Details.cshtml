@model WebBanHoa.Models.ProductDTO
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isLoggedIn = Session["UserID"] != null;
}

<style>
    body {
        background-color: #f8f9fa;
    }

    .btn-custom-pink {
        background-color: #e73685;
        color: #fff;
        border: none;
        font-weight: bold;
    }

        .btn-custom-pink:hover {
            background-color: #c92a70;
            color: #fff;
        }

    .card-img-top {
        width: 100%;
        height: 300px;
        object-fit: cover;
    }

    .product-card {
        border: none;
        border-radius: 0.5rem;
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    .price-text {
        min-height: 2.2rem;
        margin-bottom: 1rem;
        font-size: 0.95rem;
    }

    .btn-custom-order {
        background-color: #f07f2c;
        color: #fff;
        font-weight: bold;
        border: none;
    }

        .btn-custom-order:hover {
            background-color: #d97024;
            color: #fff;
        }

    .product-title a {
        color: #333;
        text-decoration: none;
        font-weight: 700;
    }

        .product-title a:hover {
            color: #e73685;
        }

    /* THÔNG BÁO CỐ ĐỊNH */
    .cart-notification-fixed {
        position: fixed;
        top: 100px;
        right: 20px;
        z-index: 10000;
        min-width: 300px;
        background: #28a745;
        color: white;
        padding: 15px;
        border-radius: 5px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        font-weight: bold;
        animation: slideIn 0.5s ease-out;
    }

    /* THÔNG BÁO YÊU CẦU ĐĂNG NHẬP */
    .login-notification-fixed {
        position: fixed;
        top: 100px;
        right: 20px;
        z-index: 10000;
        min-width: 300px;
        background: #dc3545;
        color: white;
        padding: 15px;
        border-radius: 5px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        font-weight: bold;
        animation: slideIn 0.5s ease-out;
    }

    @@keyframes slideIn {
        from {
            transform: translateY(-100%);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
</style>

<div class="container my-5">
    <div class="row g-4">

        <!-- HÌNH ẢNH SẢN PHẨM -->
        <div class="col-lg-6">
            <img src="@Url.Content("~/Content/Images/" + Model.Image)" class="img-fluid rounded shadow-sm w-100" alt="@Model.ProductName">
        </div>

        <!-- THÔNG TIN SẢN PHẨM -->
        <div class="col-lg-6">
            <h1 class="h2 fw-bold">@Model.ProductName</h1>

            <!-- GIÁ SẢN PHẨM -->
            <div class="pricing-section mb-2">
                @if (Model.DiscountRate != null && Model.DiscountRate > 0)
                {
                    <span class="text-muted text-decoration-line-through fs-4 me-2">@String.Format("{0:N0}", Model.Price) VNĐ</span>
                    <span class="text-danger fw-bold fs-2 me-3">@String.Format("{0:N0}", (Model.Price - (Model.Price * (decimal)Model.DiscountRate / 100))) VNĐ</span>
                    <span class="badge bg-danger fs-6">GIẢM @Model.DiscountRate%</span>
                }
                else
                {
                    <span class="text-danger fs-4 me-2">@String.Format("{0:N0}", Model.Price) VNĐ</span>
                }
            </div>

            <p class="text-muted fst-italic mb-4">Giá đã bao gồm 8% VAT</p>

            <!-- ƯU ĐIỂM -->
            <div class="row g-3 mb-4">
                <div class="col-md-4 col-sm-12">
                    <div class="usp-box">
                        <i class="bi bi-truck fs-2 text-primary me-3"></i>
                        <div>Giao hoa <br> <span class="fw-bold">MIỄN PHÍ</span></div>
                    </div>
                </div>
                <div class="col-md-4 col-sm-6">
                    <div class="usp-box">
                        <i class="bi bi-card-text fs-2 text-danger me-3"></i>
                        <div>Tặng kèm <br> <span class="fw-bold">THIỆP/BANNER</span></div>
                    </div>
                </div>
                <div class="col-md-4 col-sm-6">
                    <div class="usp-box">
                        <i class="bi bi-stopwatch fs-2 text-success me-3"></i>
                        <div>Giao nhanh <br> <span class="fw-bold">60 PHÚT</span></div>
                    </div>
                </div>
            </div>

            <!-- CỬA HÀNG -->
            <h5 class="fw-bold">Mua tại cửa hàng:</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="border p-3 rounded h-100">
                        <p class="mb-2">142 Nguyễn Văn Cừ, Phường Cầu Ông Lãnh, TP.HCM</p>
                        <a href="tel:1900633045" class="btn btn-outline-danger btn-sm me-2">
                            <i class="bi bi-telephone-fill"></i> 1900 633 045
                        </a>
                        <a href="#" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-geo-alt-fill"></i> Bản đồ
                        </a>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="border p-3 rounded h-100">
                        <p class="mb-2">34B Lý Nam Đế, Phường Hoàn Kiếm, Hà Nội</p>
                        <a href="tel:0942007921" class="btn btn-outline-danger btn-sm me-2">
                            <i class="bi bi-telephone-fill"></i> 0942 007 921
                        </a>
                        <a href="#" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-geo-alt-fill"></i> Bản đồ
                        </a>
                    </div>
                </div>
            </div>

            <!-- FORM: THÊM VÀO GIỎ HÀNG -->
            @if (isLoggedIn)
            {
                <!-- SỬA: Dùng form với method GET -->
                <form method="get" action="@Url.Action("ThemVaoGioHang", "Cart")">
                    <div class="row g-2 align-items-center">
                        <div class="col-auto">
                            <div class="d-flex align-items-center">
                                <label for="quantity" class="form-label me-2 mb-0 fs-5">Số lượng</label>
                                <input type="number"
                                       class="form-control"
                                       id="soLuong"
                                       name="soLuong"
                                       value="1"
                                       style="max-width: 80px;"
                                       min="1">
                                <!-- QUAN TRỌNG: Tên tham số phải là "id" -->
                                <input type="hidden" name="id" value="@Model.ProductID" />
                            </div>
                        </div>

                        <div class="col">
                            <div class="d-grid">
                                <button class="btn btn-custom-order btn-lg text-uppercase py-3 add-to-cart-btn"
                                        type="submit">
                                    <i class="bi bi-cart-plus-fill"></i> Thêm vào giỏ hàng
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            }
            else
            {
                <!-- CHƯA ĐĂNG NHẬP -->
                <div class="row g-2 align-items-center">
                    <div class="col-auto">
                        <div class="d-flex align-items-center">
                            <label for="quantity" class="form-label me-2 mb-0 fs-5">Số lượng</label>
                            <input type="number"
                                   class="form-control"
                                   id="quantity"
                                   name="quantity"
                                   value="1"
                                   style="max-width: 80px;"
                                   min="1"
                                   disabled>
                        </div>
                    </div>

                    <div class="col">
                        <div class="d-grid">
                            <a href="@Url.Action("Login", "Account", new { returnUrl = Request.Url.PathAndQuery })"
                               class="btn btn-custom-order btn-lg text-uppercase py-3 add-to-cart-btn">
                                <i class="bi bi-cart-plus-fill"></i> Thêm vào giỏ hàng
                            </a>
                        </div>
                    </div>
                </div>
            }

            <!-- NÚT CHỨC NĂNG -->
        <div class="row g-2 my-2">
            <div class="col-4 d-grid">
                @if (isLoggedIn)
                {
                    <!-- FORM THÊM VÀO GIỎ HÀNG VÀ THANH TOÁN NGAY -->
                    <form method="get" action="@Url.Action("ThemVaoGioHangVaThanhToan", "Cart")" style="margin: 0;">
                        <input type="hidden" name="id" value="@Model.ProductID" />
                        <input type="hidden" name="soLuong" value="1" />
                        <button type="submit" class="btn btn-outline-warning text-dark w-100">
                            <i class="bi bi-lightning-fill"></i> Đặt nhanh
                        </button>
                    </form>
                }
                else
                {
                    <a href="@Url.Action("Login", "Account", new { returnUrl = Request.Url.PathAndQuery })"
                       class="btn btn-outline-warning text-dark">
                        <i class="bi bi-lightning-fill"></i> Đặt nhanh
                    </a>
                }
            </div>
            <div class="col-4 d-grid">
                <a href="#" class="btn btn-outline-primary">
                    <i class="bi bi-chat-left-text"></i> Zalo OA
                </a>
            </div>
            <div class="col-4 d-grid">
                <a href="https://www.facebook.com/hai.quan.241416?mibextid=wwXIfr&rdid=FD3mgh8JBhaAsNvk&share_url=https%3A%2F%2Fwww.facebook.com%2Fshare%2F1FDHCNhDEc%2F%3Fmibextid%3DwwXIfr#"
                   class="btn btn-outline-primary" target="_blank">
                    <i class="bi bi-facebook"></i> Facebook
                </a>
            </div>
        </div>
        </div>

        <!-- MÔ TẢ SẢN PHẨM (ĐẶT DƯỚI CÙNG, CHIẾM TOÀN BỘ CHIỀU RỘNG) -->
        <div class="col-12 mt-4">
            <div class="product-description-container">
                <ul class="nav nav-tabs" style="border-bottom: 2px solid #dee2e6;">
                    <li class="nav-item">
                        <a class="nav-link active" href="#"
                           style="border: 1px solid #dee2e6; border-bottom: none;
                                  font-weight: bold; color: #333; background-color: #fff;">
                            Mô tả sản phẩm
                        </a>
                    </li>
                </ul>

                <div class="description-content" style="border: 1px solid #dee2e6; border-top: none; padding: 20px;">
                    @Html.Raw(Model.Description)
                </div>
            </div>
        </div>

        <!-- HIỂN THỊ THÔNG BÁO TỪ SERVER -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="cart-notification-fixed">
                <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            </div>

            <!-- Tự động ẩn bằng meta refresh (không dùng JS) -->
            <meta http-equiv="refresh" content="3;url=@Request.Url.PathAndQuery" />
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="login-notification-fixed">
                <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
            </div>

            <!-- Tự động ẩn bằng meta refresh (không dùng JS) -->
            <meta http-equiv="refresh" content="3;url=@Request.Url.PathAndQuery" />
        }

        <!-- SẢN PHẨM LIÊN QUAN (ĐẶT DƯỚI MÔ TẢ) -->
        <div class="col-12 mt-4">
            @Html.Action("_RelevantProducts", "Home", new { categoryID = Model.CategoryID, productID = Model.ProductID })
        </div>
    </div>
</div>

<!-- IFRAME ẨN ĐỂ NHẬN RESPONSE -->
<iframe name="cartIframe"
        id="cartIframe"
        style="display:none; width:0; height:0; border:0; position:absolute; left:-9999px;"></iframe>

<!-- META TAG ĐỂ TỰ ĐỘNG TẢI LẠI TRANG SAU 3 GIÂY NẾU CÓ THÔNG BÁO -->
@if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
{
    <meta http-equiv="refresh" content="3;url=@Request.Url.PathAndQuery" />
}