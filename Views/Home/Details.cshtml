@model WebBanHoa.Models.ProductDTO
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // BỔ SUNG: Kiểm tra trạng thái đăng nhập
    bool isLoggedIn = Session["UserID"] != null;
}
<style>
    body {
        background-color: #f8f9fa;
    }

    .btn-custom-pink {
        background-color: #e73685;
        color: #fff;
        border: none;
        font-weight: bold;
    }

        .btn-custom-pink:hover {
            background-color: #c92a70;
            color: #fff;
        }

    .card-img-top {
        width: 100%;
        height: 300px;
        object-fit: cover;
    }

    .product-card {
        border: none;
        border-radius: 0.5rem;
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    .price-text {
        min-height: 2.2rem;
        margin-bottom: 1rem;
        font-size: 0.95rem;
    }

    .btn-custom-order {
        background-color: #f07f2c;
        color: #fff;
        font-weight: bold;
        border: none;
    }

        .btn-custom-order:hover {
            background-color: #d97024;
            color: #fff;
        }

    .product-title a {
        color: #333;
        text-decoration: none;
        font-weight: 700;
    }

        .product-title a:hover {
            color: #e73685;
        }

    /* THÔNG BÁO */
    .cart-notification {
        position: fixed;
        top: 100px;
        right: 20px;
        z-index: 10000;
        min-width: 300px;
        background: #28a745;
        color: white;
        padding: 15px;
        border-radius: 5px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        font-weight: bold;
        display: none;
        animation: fadeInOut 3s ease-in-out;
    }

    /* THÔNG BÁO YÊU CẦU ĐĂNG NHẬP (BỔ SUNG) */
    .login-required-notification {
        position: fixed;
        top: 100px;
        right: 20px;
        z-index: 10000;
        min-width: 300px;
        background: #dc3545;
        color: white;
        padding: 15px;
        border-radius: 5px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        font-weight: bold;
        display: none;
        animation: fadeInOut 3s ease-in-out;
    }

    @@keyframes fadeInOut {
        0% {
            opacity: 0;
            transform: translateY(-20px);
        }

        10% {
            opacity: 1;
            transform: translateY(0);
        }

        90% {
            opacity: 1;
            transform: translateY(0);
        }

        100% {
            opacity: 0;
            transform: translateY(-20px);
        }
    }
</style>
<div class="container my-5">
    <div class="row g-4">

        <div class="col-lg-6">
            <img src="@Url.Content("~/Content/Images/" + Model.Image)" class="img-fluid rounded shadow-sm w-100" alt="Bó hoa Nồng Nàn Tình Yêu">
        </div>

        <div class="col-lg-6">
            <h1 class="h2 fw-bold">@Model.ProductName</h1>

            <div class="pricing-section mb-2">
                @if (Model.DiscountRate != null && Model.DiscountRate > 0)
                {
                    <span class="text-muted text-decoration-line-through fs-4 me-2">@String.Format("{0:N0}", Model.Price) VNĐ</span>
                    <span class="text-danger fw-bold fs-2 me-3">@String.Format("{0:N0}", (Model.Price - (Model.Price * (decimal)Model.DiscountRate / 100))) VNĐ</span>
                    <span class="badge bg-danger fs-6">GIẢM @Model.DiscountRate%</span>
                }
                else
                {
                    <span class="text-danger fs-4 me-2">@String.Format("{0:N0}", Model.Price) VNĐ</span>
                }
            </div>

            <p class="text-muted fst-italic mb-4">Giá đã bao gồm 8% VAT</p>

            <div class="row g-3 mb-4">
                <div class="col-md-4 col-sm-12">
                    <div class="usp-box">
                        <i class="bi bi-truck fs-2 text-primary me-3"></i>
                        <div>Giao hoa <br> <span class="fw-bold">MIỄN PHÍ</span></div>
                    </div>
                </div>
                <div class="col-md-4 col-sm-6">
                    <div class="usp-box">
                        <i class="bi bi-card-text fs-2 text-danger me-3"></i>
                        <div>Tặng kèm <br> <span class="fw-bold">THIỆP/BANNER</span></div>
                    </div>
                </div>
                <div class="col-md-4 col-sm-6">
                    <div class="usp-box">
                        <i class="bi bi-stopwatch fs-2 text-success me-3"></i>
                        <div>Giao nhanh <br> <span class="fw-bold">60 PHÚT</span></div>
                    </div>
                </div>
            </div>

            <h5 class="fw-bold">Mua tại cửa hàng:</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="border p-3 rounded h-100">
                        <p class="mb-2">142 Nguyễn Văn Cừ, Phường Cầu Ông Lãnh, TP.HCM</p>
                        <a href="tel:1900633045" class="btn btn-outline-danger btn-sm me-2">
                            <i class="bi bi-telephone-fill"></i> 1900 633 045
                        </a>
                        <a href="#" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-geo-alt-fill"></i> Bản đồ
                        </a>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="border p-3 rounded h-100">
                        <p class="mb-2">34B Lý Nam Đế, Phường Hoàn Kiếm, Hà Nội</p>
                        <a href="tel:0942007921" class="btn btn-outline-danger btn-sm me-2">
                            <i class="bi bi-telephone-fill"></i> 0942 007 921
                        </a>
                        <a href="#" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-geo-alt-fill"></i> Bản đồ
                        </a>
                    </div>
                </div>
            </div>

            <!-- FORM: THÊM VÀO GIỎ HÀNG -->
            @if (isLoggedIn)
            {
                <!-- ĐÃ ĐĂNG NHẬP: Hiển thị form thêm vào giỏ -->
                using (Html.BeginForm("AddToCart", "Cart", FormMethod.Post, new
                {
                    id = "addToCartForm",
                    target = "cartIframe"
                }))
                {
                    @Html.Hidden("productId", Model.ProductID)
                    @Html.Hidden("returnUrl", Request.Url.PathAndQuery)

                    <div class="row g-2 align-items-center">
                        <div class="col-auto">
                            <div class="d-flex align-items-center">
                                <label for="quantity" class="form-label me-2 mb-0 fs-5">Số lượng</label>
                                <input type="number"
                                       class="form-control"
                                       id="quantity"
                                       name="quantity"
                                       value="1"
                                       style="max-width: 80px;"
                                       min="1">
                            </div>
                        </div>

                        <div class="col">
                            <div class="d-grid">
                                <button class="btn btn-custom-order btn-lg text-uppercase py-3 add-to-cart-btn"
                                        type="button"
                                        onclick="addToCartWithNotification(event)">
                                    <i class="bi bi-cart-plus-fill"></i> Thêm vào giỏ hàng
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- CHƯA ĐĂNG NHẬP: Hiển thị nút chuyển đến trang đăng nhập -->
                <div class="row g-2 align-items-center">
                    <div class="col-auto">
                        <div class="d-flex align-items-center">
                            <label for="quantity" class="form-label me-2 mb-0 fs-5">Số lượng</label>
                            <input type="number"
                                   class="form-control"
                                   id="quantity"
                                   name="quantity"
                                   value="1"
                                   style="max-width: 80px;"
                                   min="1"
                                   disabled>
                        </div>
                    </div>

                    <div class="col">
                        <div class="d-grid">
                            <a href="@Url.Action("Login", "Account", new { returnUrl = Request.Url.PathAndQuery })"
                               class="btn btn-custom-order btn-lg text-uppercase py-3 add-to-cart-btn"
                               onclick="showLoginRequiredNotification(event)">
                                <i class="bi bi-cart-plus-fill"></i> Thêm vào giỏ hàng
                            </a>
                        </div>
                    </div>
                </div>
            }

            <!-- IFRAME ẨN để nhận response từ server mà không reload trang -->
            <iframe name="cartIframe"
                    id="cartIframe"
                    style="display:none; width:0; height:0; border:0; position:absolute; left:-9999px;"></iframe>

            <!-- ĐẶT NHANH -->
            <div class="row g-2 my-2">
                <div class="col-4 d-grid">
                    <a href="@Url.Action("Index", "GioHang")" class="btn btn-outline-warning text-dark">
                        <i class="bi bi-lightning-fill"></i> Đặt nhanh
                    </a>
                </div>
                <div class="col-4 d-grid">
                    <a href="#" class="btn btn-outline-primary">
                        <i class="bi bi-chat-left-text"></i> Zalo OA
                    </a>
                </div>
                <div class="col-4 d-grid">
                    <a href="#" class="btn btn-outline-primary">
                        <i class="bi bi-facebook"></i> Facebook
                    </a>
                </div>
            </div>
        </div>

        <div class="product-description-container">
            <ul class="nav nav-tabs" style="border-bottom: 2px solid #dee2e6;">
                <li class="nav-item">
                    <a class="nav-link active" href="#"
                       style="border: 1px solid #dee2e6; border-bottom: none;
                      font-weight: bold; color: #333; background-color: #fff;">
                        Mô tả sản phẩm
                    </a>
                </li>
            </ul>

            <div class="description-content" style="border: 1px solid #dee2e6; border-top: none; padding: 20px;">
                @Html.Raw(Model.Description)
            </div>
        </div>

        <!-- THÔNG BÁO TEMPDATA (từ server) -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @Html.Action("_RelevantProducts", "Home", new { categoryID = Model.CategoryID, productID = Model.ProductID })
    </div>
</div>

<!-- SCRIPT HIỂN THỊ THÔNG BÁO -->
<script>
    // Thêm vào giỏ hàng với thông báo (CHỈ KHI ĐÃ ĐĂNG NHẬP)
    function addToCartWithNotification(event) {
        // Ngăn hành vi mặc định
        event.preventDefault();

        // Lấy tên sản phẩm
        var productName = '@Model.ProductName';

        // Hiển thị thông báo ngay lập tức
        showSuccessNotification(productName);

        // Cập nhật số lượng giỏ hàng
        updateCartBadge();

        // Submit form vào iframe sau 0.5s để người dùng thấy thông báo
        setTimeout(function() {
            document.getElementById('addToCartForm').submit();
        }, 500);
    }

    // HIỂN THỊ THÔNG BÁO YÊU CẦU ĐĂNG NHẬP (BỔ SUNG)
    function showLoginRequiredNotification(event) {
        // Ngăn chuyển trang ngay lập tức
        event.preventDefault();

        // Hiển thị thông báo
        var notification = document.getElementById('login-required-notification');
        if (!notification) {
            notification = document.createElement('div');
            notification.id = 'login-required-notification';
            notification.className = 'login-required-notification';
            document.body.appendChild(notification);
        }

        notification.innerHTML = '⚠️ Vui lòng đăng nhập để thêm vào giỏ hàng. Đang chuyển đến trang đăng nhập...';
        notification.style.display = 'block';

        // Chuyển đến trang đăng nhập sau 2 giây
        setTimeout(function() {
            window.location.href = '@Url.Action("Login", "Account")?returnUrl=' + encodeURIComponent(window.location.pathname);
        }, 2000);

        // Tự động ẩn thông báo sau 3 giây
        setTimeout(function() {
            notification.style.display = 'none';
        }, 3000);
    }

    function showSuccessNotification(productName) {
        // Tạo hoặc cập nhật thông báo
        var notification = document.getElementById('cart-notification');
        if (!notification) {
            notification = document.createElement('div');
            notification.id = 'cart-notification';
            notification.className = 'cart-notification';
            document.body.appendChild(notification);
        }

        notification.innerHTML = '✓ Đã thêm "' + productName + '" vào giỏ hàng';
        notification.style.display = 'block';

        // Tự động ẩn sau 3 giây (CSS animation sẽ xử lý)
        setTimeout(function() {
            notification.style.display = 'none';
        }, 3000);
    }

    function updateCartBadge() {
        // Cập nhật số lượng giỏ hàng
        var badge = document.querySelector('.cart-badge');
        if (badge) {
            var currentCount = parseInt(badge.textContent) || 0;
            var quantity = parseInt(document.getElementById('quantity').value) || 1;
            badge.textContent = currentCount + quantity;
            badge.style.display = 'block';
        }
    }
</script>