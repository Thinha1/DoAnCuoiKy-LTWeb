@model List<WebBanHoa.Models.ProductDTO>

<link href="~/Content/css/card_product.css" rel="stylesheet" />

<!-- BỔ SUNG CSS THÔNG BÁO -->
<style>
    .cart-notification {
        position: fixed;
        top: 100px;
        right: 20px;
        z-index: 10000;
        min-width: 300px;
        background: #28a745;
        color: white;
        padding: 15px;
        border-radius: 5px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        font-weight: bold;
        display: none;
        animation: fadeInOut 3s ease-in-out;
    }

    .login-required-notification {
        position: fixed;
        top: 100px;
        right: 20px;
        z-index: 10000;
        min-width: 300px;
        background: #dc3545;
        color: white;
        padding: 15px;
        border-radius: 5px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        font-weight: bold;
        display: none;
        animation: fadeInOut 3s ease-in-out;
    }

    @@keyframes fadeInOut {
        0% {
            opacity: 0;
            transform: translateY(-20px);
        }

        10% {
            opacity: 1;
            transform: translateY(0);
        }

        90% {
            opacity: 1;
            transform: translateY(0);
        }

        100% {
            opacity: 0;
            transform: translateY(-20px);
        }
    }

    /* FORM ẨN */
    .hidden-cart-form {
        display: none;
    }
</style>

<h2 class="mb-4 mt-4 text-center">ĐANG GIẢM GIÁ</h2>
<div class="row" style="margin-top: 10px">

    @foreach (var sp in Model)
    {
        <div class="col-md-3 col-sm-6 col-xs-6 mb-4">
            <a href="@Url.Action("Details", "Home", new {ProductID = sp.ProductID.Trim()})" style="text-decoration: none">
                <div class="product-card">

                    <div class="product-image-container">
                        <img src="@Url.Content("~/Content/Images/" + sp.Image)" alt="@sp.ProductName" class="img-fluid" />

                        @{
                            if (sp.DiscountRate != null)
                            {
                                <div class="sale-badge">
                                    GIẢM @sp.DiscountRate%
                                </div>
                            }
                        }
                    </div>

                    <div class="product-info text-center">
                        <h5 class="product-name">@sp.ProductName</h5>
                        @{
                            decimal? salePrice;
                            var discount = sp.DiscountRate;
                            if (discount != null)
                            {
                                salePrice = sp.Price - (sp.Price * (decimal)discount / 100);
                                <div class="product-price">
                                    <span class="price-sale">@String.Format("{0:N0}", salePrice) VNĐ</span>
                                    <span class="price-original">@String.Format("{0:N0}", sp.Price) VNĐ</span>
                                </div>
                            }
                            else
                            {
                                salePrice = sp.Price;
                                <div class="product-price">
                                    <span class="price-sale" style="text-decoration: none">@String.Format("{0:N0}", sp.Price) VNĐ</span>
                                </div>
                            }
                        }

                        <!-- NÚT THÊM VÀO GIỎ (BỔ SUNG) -->
                        <button class="btn btn-order add-to-cart-list"
                                type="button"
                                data-product-id="@sp.ProductID"
                                data-product-name="@sp.ProductName"
                                onclick="addToCartFromList(event, this)">
                            Thêm vào giỏ
                        </button>
                    </div>

                </div>
            </a>
        </div>
    }
</div>

<!-- IFRAME ẨN (BỔ SUNG) -->
<iframe name="cartIframe" id="cartIframe"
        style="display:none; width:0; height:0; border:0; position:absolute; left:-9999px;"></iframe>

<!-- FORM ẨN ĐỂ GỬI DỮ LIỆU (BỔ SUNG) -->
<form id="globalCartForm" method="post" action="@Url.Action("AddToCart", "Cart")"
      target="cartIframe" class="hidden-cart-form">
    <input type="hidden" name="productId" id="formProductId" />
    <input type="hidden" name="quantity" id="formQuantity" value="1" />
    <input type="hidden" name="returnUrl" id="formReturnUrl" value="@Request.Url.PathAndQuery" />
</form>

<!-- SCRIPT XỬ LÝ (BỔ SUNG) -->
<script>
    // Thêm vào giỏ hàng từ danh sách
    function addToCartFromList(event, button) {
        // Ngăn sự kiện mặc định
        event.preventDefault();
        event.stopPropagation();

        // KIỂM TRA ĐĂNG NHẬP (BỔ SUNG)
        var isLoggedIn = checkLoginStatus();
        if (!isLoggedIn) {
            showLoginRequiredNotification();
            // Chuyển đến trang đăng nhập sau 2 giây
            setTimeout(function() {
                window.location.href = '@Url.Action("Login", "Account")?returnUrl=' + encodeURIComponent(window.location.pathname);
            }, 2000);
            return; // Dừng lại không thực hiện tiếp
        }

        // Lấy dữ liệu từ button
        var productId = button.getAttribute('data-product-id');
        var productName = button.getAttribute('data-product-name');

        // Hiển thị thông báo
        showSuccessNotification(productName);

        // Cập nhật số lượng giỏ hàng
        updateCartBadge();

        // Gửi dữ liệu đến server
        submitCartForm(productId);
    }

    // KIỂM TRA TRẠNG THÁI ĐĂNG NHẬP (BỔ SUNG)
    function checkLoginStatus() {
        // Cách 1: Kiểm tra cookie/session (nếu có)
        // Cách 2: Kiểm tra xem có userID trong session không (server-side)
        // Cách 3: Gọi AJAX để kiểm tra

        // Tạm thời kiểm tra bằng cách gọi action (có thể dùng AJAX)
        // Hoặc dùng biến từ server
        var isAuthenticated = @(Session["UserID"] != null ? "true" : "false");
        return isAuthenticated;
    }

    // HIỂN THỊ THÔNG BÁO YÊU CẦU ĐĂNG NHẬP (BỔ SUNG)
    function showLoginRequiredNotification() {
        var notification = document.getElementById('login-required-notification');
        if (!notification) {
            notification = document.createElement('div');
            notification.id = 'login-required-notification';
            notification.className = 'login-required-notification';
            document.body.appendChild(notification);
        }

        notification.innerHTML = '⚠️ Vui lòng đăng nhập để thêm vào giỏ hàng. Đang chuyển đến trang đăng nhập...';
        notification.style.display = 'block';

        // Tự động ẩn sau 3 giây
        setTimeout(function() {
            notification.style.display = 'none';
        }, 3000);
    }

    // Hiển thị thông báo thành công
    function showSuccessNotification(productName) {
        // Tạo hoặc cập nhật thông báo
        var notification = document.getElementById('cart-notification');
        if (!notification) {
            notification = document.createElement('div');
            notification.id = 'cart-notification';
            notification.className = 'cart-notification';
            document.body.appendChild(notification);
        }

        notification.innerHTML = '✓ Đã thêm "' + productName + '" vào giỏ hàng';
        notification.style.display = 'block';

        // Tự động ẩn sau 3 giây
        setTimeout(function() {
            notification.style.display = 'none';
        }, 3000);
    }

    // Cập nhật badge giỏ hàng
    function updateCartBadge() {
        var badge = document.querySelector('.cart-badge');
        if (badge) {
            var currentCount = parseInt(badge.textContent) || 0;
            badge.textContent = currentCount + 1;
            badge.style.display = 'block';
        }
    }

    // Gửi form đến server
    function submitCartForm(productId) {
        // Đặt giá trị vào form ẩn
        document.getElementById('formProductId').value = productId;

        // Submit form
        document.getElementById('globalCartForm').submit();
    }
</script>