@model List<WebBanHoa.Models.ProductType>

@foreach (var lsp in Model)
{
    <ul class="nav nav-pills nav-justified">
        <li class="nav-item dropdown" style="margin: 0 10px">
            <a class="nav-link "
               href="#"
               data-bs-toggle="dropdown">@lsp.ProductTypeName</a>
            @{
                if (lsp.ProductType1 != null && lsp.ProductType1.Any())
                {

                    <ul class="dropdown-menu">
                        @foreach (var con in lsp.ProductType1)
                        {
                            <li>@Html.ActionLink(con.ProductTypeName, "SPTheoLoai", "Product", new { productTypeID = con.ProductTypeID }, new { @class = "dropdown-item" })</li>
                        }
                    </ul>
                }
            }


        </li>
    </ul>
}
