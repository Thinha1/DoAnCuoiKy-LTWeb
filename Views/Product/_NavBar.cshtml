@model List<WebBanHoa.Models.Category>
@{
    // Lấy danh sách Theme từ ViewBag
    List<WebBanHoa.Models.Theme> themesList = ViewBag.Themes as List<WebBanHoa.Models.Theme>;
}

<ul class="nav nav-pills nav-justified">

    @foreach (var lsp in Model)
    {
        <li class="nav-item dropdown" style="margin: 0 10px">
            <a class="nav-link" href="#" data-bs-toggle="dropdown">@lsp.CategoryName</a>
            @{
                // Kiểm tra xem có danh mục con không
                if (lsp.Category1 != null && lsp.Category1.Any())
                {
                    <ul class="dropdown-menu">
                        @foreach (var con in lsp.Category1)
                        {
                            <li>@Html.ActionLink(con.CategoryName, "SPTheoLoai", "Product", new { categoryID = con.CategoryID }, new { @class = "dropdown-item" })</li>
                        }
                    </ul>
                }
            }
        </li>
    }

    @if (themesList != null) // Kiểm tra xem themesList có dữ liệu không
    {
        foreach (var th in themesList)
        {
            <li class="nav-item dropdown" style="margin: 0 10px">
                <a class="nav-link" href="#" data-bs-toggle="dropdown">@th.ThemeName</a>
                @{
                    // Kiểm tra xem có chủ đề con không (Giả định tên thuộc tính là Theme1)
                    if (th.Theme1 != null && th.Theme1.Any())
                    {
                        <ul class="dropdown-menu">
                            @foreach (var con in th.Theme1)
                            {
                                <li>@Html.ActionLink(con.ThemeName, "SPTheoChuDe", "Product", new { themeID = con.ThemeID }, new { @class = "dropdown-item" })</li>
                            }
                        </ul>
                    }
                }
            </li>
        }
    }

</ul>
