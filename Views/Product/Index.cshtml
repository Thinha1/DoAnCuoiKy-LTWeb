@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<WebBanHoa.Models.ProductType> categoryTypes = ViewBag.ParentTypes as List<WebBanHoa.Models.ProductType>;
}

@Html.Action("_DiscountingProducts", "Product")
@Html.Action("_MostOrderedProducts", "Product")

@*Những danh mục sản phẩm cha*@
@foreach (var type in categoryTypes.Where(t => t.ProductTypeParentID == null))
{
    if (categoryTypes.Count > 0)
    {
        @Html.Action("_SPTheoTungLoai", "Product", new { productTypeID = type.ProductTypeID })
    }
}