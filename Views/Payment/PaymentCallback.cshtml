@{
    ViewBag.Title = "Kết quả thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container text-center py-5">
    <div class="card shadow-sm mx-auto" style="max-width: 500px;">
        <div class="card-body">
            <i class="@ViewBag.Icon fa-5x mb-3"></i>
            <h3 class="card-title">@ViewBag.Message</h3>

            <p class="text-muted">Cảm ơn bạn đã sử dụng dịch vụ của WebBanHoa.</p>

            <div class="mt-4">
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary px-4">Về trang chủ</a>
                <a href="@Url.Action("Index", "Order")" class="btn btn-outline-secondary px-4">Xem đơn hàng</a>
            </div>
        </div>
    </div>
</div>