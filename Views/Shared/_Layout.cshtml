<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shop Hoa Tươi FlowerCorner.vn</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/Content/css/style.css" />
</head>
<body>
    <!-- Dòng 1 -->
    <div class="top-bar container-fluid d-flex justify-content-between px-5">
        <div>HOTLINE: 1900 633 045 | 0865 160 360</div>
        <div class="d-flex" style="gap: 20px">
            <div class="account-menu">
                <span>Tài Khoản <i class="fa fa-caret-down"></i></span>
                <div class="account-dropdown">
                    <a href="#">Đăng Ký</a>
                    <a href="#">Đăng Nhập</a>
                </div>
            </div>
            <a href="#">Giỏ Hàng</a>
            <a href="#">Thanh Toán</a>
        </div>
    </div>

    <!-- Dòng 2 -->
    <div class="container logo-row row text-center">
        <!-- Cột 1 -->
        <div class="col-2 d-flex justify-content-center align-items-center gap-3">
            <a href="#">
                <i class="fab fa-facebook fa-lg" style="color: #1877f2"></i>
            </a>
            <a href="#">
                <i class="fab fa-instagram fa-lg" style="color: #e1306c"></i>
            </a>
            <a href="#">
                <i class="fab fa-twitter fa-lg" style="color: #1da1f2"></i>
            </a>
        </div>

        <!-- Cột 2 -->
        <div class="col-8">
            <a href="/Product/Index">
                <img src="~/Content/Images/logo/logo-flower-corner-horizontal.jpg"
                     alt="Logo"
                     class="img-fluid" />
            </a>
        </div>

        <!-- Cột 3 -->
        <div class="col-2 d-flex justify-content-center align-items-center gap-3">
            <div class="search-box">
                <input type="text" placeholder="Tìm kiếm" />
                <button><i class="fa fa-search"></i></button>
            </div>
            <a href="giohang.html">
                <i class="fa fa-shopping-cart fa-lg text-white"></i>
            </a>
        </div>
    </div>

    <!-- Dòng 3: Menu ngang -->
    <nav class="navbar navbar-expand-lg">
        <div class="container justify-content-center">
            @Html.Action("_NavBar", "Product")
        </div>
    </nav>

    <!-- Dòng 4 -->
    <div class="hotline-banner">
        Hotline Đặt Hoa Nhanh - TP HCM: 1900 633 045 - Hà Nội: 094 200 7921
    </div>

    <!-- Dòng 5: Carousel -->
    <div id="carousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (int i = 1; i <= 4; i++)
            {
                <div class="carousel-item @(i == 1 ? "active" : "")">
                    <img src="@Url.Content("~/Content/Images/Banner/banner_" + i + ".jpg")"
                         class="d-block w-100"
                         alt="" />
                </div>
            }
        </div>
        <button class="carousel-control-prev"
                type="button"
                data-bs-target="#carousel"
                data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next"
                type="button"
                data-bs-target="#carousel"
                data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
    <div class="container">
        @RenderBody()
    </div>
    <!-- Thanh cố định cuối trang -->
    <div class="fixed-bottom-bar">
        <div class="contact-group">
            <div class="contact-item">
                <i class="bi bi-telephone-fill"></i>
                <span>091 849 1941</span>
            </div>

            <div class="contact-item">
                <i class="bi bi-chat-dots-fill"></i>
                <span>Nhắn Tin Zalo</span>
            </div>

            <div class="contact-item">
                <i class="bi bi-telephone-fill"></i>
                <span>086 516 0360</span>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="container">
            <div class="row">

                <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                    <h5 class="footer-heading">Về FlowerCorner</h5>
                    <p class="footer-text">
                        Shop hoa tươi FlowerCorner.vn là một trong những tiệm hoa tươi uy tín nhất tại TP HCM, Việt Nam. Chúng tôi cam kết mang đến cho bạn những sản phẩm hoa tươi chất lượng cao.
                    </p>
                </div>

                <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                    <h5 class="footer-heading">Loại Sản Phẩm</h5>
                    <ul class="list-unstyled footer-links">
                        <li><a href="#">Hoa Hồng</a></li>
                        <li><a href="#">Lan Hồ Điệp</a></li>
                        <li><a href="#">Hoa Hướng Dương</a></li>
                        <li><a href="#">Hoa Baby</a></li>
                        <li><a href="#">Hoa Tulip</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                    <h5 class="footer-heading">Chủ Đề</h5>
                    <ul class="list-unstyled footer-links">
                        <li><a href="#">Hoa Sinh Nhật</a></li>
                        <li><a href="#">Hoa Khai Trương</a></li>
                        <li><a href="#">Hoa Tình Yêu</a></li>
                        <li><a href="#">Hoa Chúc Mừng</a></li>
                        <li><a href="#">Hoa Chia Buồn</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                    <h5 class="footer-heading">Chính Sách</h5>
                    <ul class="list-unstyled footer-links">
                        <li><a href="#">Chính sách giao hàng</a></li>
                        <li><a href="#">Chính sách đổi trả</a></li>
                        <li><a href="#">Phương thức thanh toán</a></li>
                        <li><a href="#">Bảo mật thông tin</a></li>
                        <li><a href="#">Câu hỏi thường gặp</a></li>
                    </ul>
                </div>

            </div>
        </div>
    </footer>

    <div class="simple-contact-footer">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-4 text-center text-md-start mb-2 mb-md-0">
                    <a href="tel:0918481941" class="footer-phone-link">
                        <i class="fas fa-phone-alt"></i> 091 848 1941
                    </a>
                </div>

                <div class="col-md-4 text-center mb-2 mb-md-0">
                    <a href="#" class="btn-zalo-footer" role="button">
                        Nhắn Tin Zalo
                    </a>
                </div>

                <div class="col-md-4 text-center text-md-end">
                    <a href="tel:0865160360" class="footer-phone-link">
                        <i class="fas fa-phone-alt"></i> 086 516 0360
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
