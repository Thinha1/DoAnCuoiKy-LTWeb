    //function showLogin() {
    //    $('#registerModal').modal('hide');
    //    setTimeout(() => $('#loginModal').modal('show'), 500);
    //}

    //function showRegister() {
    //    $('#loginModal').modal('hide');
    //    setTimeout(() => $('#registerModal').modal('show'), 500);
    //}

