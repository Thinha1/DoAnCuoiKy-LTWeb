<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shop Hoa Tươi FlowerCorner.vn</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/Content/css/style.css" />
</head>
<body>
    <!-- Dòng 1 -->
    <div class="top-bar container-fluid d-flex justify-content-between px-5">
        <div>HOTLINE: 1900 633 045 | 0865 160 360</div>
        <div class="d-flex" style="gap: 20px">
            <div class="account-menu">
                <span>Tài Khoản <i class="fa fa-caret-down"></i></span>
                <div class="account-dropdown">
                    <a href="#">Đăng Ký</a>
                    <a href="#">Đăng Nhập</a>
                </div>
            </div>
            <a href="#">Giỏ Hàng</a>
            <a href="#">Thanh Toán</a>
        </div>
    </div>

    <!-- Dòng 2 -->
    <div class="container logo-row row text-center">
        <!-- Cột 1 -->
        <div class="col-2 d-flex justify-content-center align-items-center gap-3">
            <a href="#">
                <i class="fab fa-facebook fa-lg" style="color: #1877f2"></i>
            </a>
            <a href="#">
                <i class="fab fa-instagram fa-lg" style="color: #e1306c"></i>
            </a>
            <a href="#">
                <i class="fab fa-twitter fa-lg" style="color: #1da1f2"></i>
            </a>
        </div>

        <!-- Cột 2 -->
        <div class="col-8">
            <a href="/Product/Index">
                <img src="~/Content/Images/logo/logo-flower-corner-horizontal.jpg"
                     alt="Logo"
                     class="img-fluid" />
            </a>
        </div>

        <!-- Cột 3 -->
        <div class="col-2 d-flex justify-content-center align-items-center gap-3">
            <div class="search-box">
                <input type="text" placeholder="Tìm kiếm" />
                <button><i class="fa fa-search"></i></button>
            </div>
            <a href="giohang.html">
                <i class="fa fa-shopping-cart fa-lg text-white"></i>
            </a>
        </div>
    </div>

    <!-- Dòng 3: Menu ngang -->
    <nav class="navbar navbar-expand-lg">
        <div class="container justify-content-center">
            @Html.Action("_NavBar", "Product")
        </div>
    </nav>

    <!-- Dòng 4 -->
    <div class="hotline-banner">
        Hotline Đặt Hoa Nhanh - TP HCM: 1900 633 045 - Hà Nội: 094 200 7921
    </div>

    <div class="container">
        @RenderBody()
    </div>
    <!-- Thanh cố định cuối trang -->
    <div class="fixed-bottom-bar">
        <div class="contact-group">
            <div class="contact-item">
                <i class="bi bi-telephone-fill"></i>
                <span>091 849 1941</span>
            </div>

            <div class="contact-item">
                <i class="bi bi-chat-dots-fill"></i>
                <span>Nhắn Tin Zalo</span>
            </div>

            <div class="contact-item">
                <i class="bi bi-telephone-fill"></i>
                <span>086 516 0360</span>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="mt-5">
        <div>Shop Hoa Tươi FlowerCorner.vn</div>
        <div class="container footer-columns">
            <div class="row justify-content-center align-items-start">
                <!-- Cột 1 -->
                <div class="col-md-5 text-center">
                    <p>f1.1</p>
                    <a href="https://www.youtube.com/watch?v=slv6L1Bzk14&source_ve_path=MjM4NTE"
                       target="_blank">
                        <img src="https://img.youtube.com/vi/slv6L1Bzk14/hqdefault.jpg"
                             alt="YouTube video thumbnail"
                             class="img-fluid rounded mt-3"
                             style="max-width: 300px; border: 2px solid white" />
                    </a>
                </div>

                <!-- Cột 2 -->
                <div class="col-md-5 text-center">
                    <p>f2-1</p>
                    <p>f2-2</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
